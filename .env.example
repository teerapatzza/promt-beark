# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — .env ไม่เข้า git

# กุญแจค้นหาสถานที่ Longdo Map
LONGDO_API_KEY=

# ── เข้าสู่ระบบด้วย Microsoft 365 (Microsoft Entra ID) ──
# ตั้งครบทั้ง 4 ตัว = เปิดใช้งาน  ตั้งไม่ครบ = ปิด ล็อกอินด้วยรหัสผ่านตามปกติ
# ขอค่าเหล่านี้จาก IT (ดู docs/MICROSOFT-365-LOGIN.md)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# ต้องตรงกับที่ลงทะเบียนใน Entra เป๊ะทุกตัวอักษร
#   production : https://promberk.ha.or.th/auth/microsoft/callback
#   UAT        : http://localhost:8081/auth/microsoft/callback
MS_REDIRECT_URI=

# ตั้งเป็น false ถ้าไม่อยากให้คนใหม่ถูกสร้างบัญชีอัตโนมัติตอนล็อกอินครั้งแรก
MS_AUTO_CREATE_USERS=true

# ── ลิงก์ลับสำหรับเข้าใช้ระหว่างปิดปรับปรุง ──
# ระหว่างที่แอปปิด คนทั่วไปเห็นหน้า "ปิดปรับปรุงชั่วคราว"
# ส่วนทีมงานเปิด https://promberk.ha.or.th/__maint-bypass/<ค่านี้> หนึ่งครั้ง
# เบราว์เซอร์จะจำคุกกี้ไว้ 90 วัน แล้วเข้าใช้งานได้ตามปกติ
# สร้างค่าใหม่: openssl rand -hex 12
# ไม่ตั้ง = ไม่มีใครผ่านด่านได้เลย (ปลอดภัยไว้ก่อน)
MAINT_TOKEN=
