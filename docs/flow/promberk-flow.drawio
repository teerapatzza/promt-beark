  <diagram name="2. ระบบคิดอะไร" id="sysflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sTitle" value="พร้อมเบิก — สิ่งที่ระบบทำเอง (เวอร์ชัน 2.20.0 · 20 ต.ค. 2569)&#10;ฟ้า = เรียกเซิร์ฟเวอร์ · เขียว = คำนวณในเครื่อง · ส้ม = ตัดสินใจเรื่องเงิน" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="ผู้ใช้เลือกสถานที่จากรายการ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="250" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="GET /map-search&#10;เก็บพิกัดเป็น geoFrom / geoTo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="recalcRoute()&#10;GET /map-route → ระยะทางขาไป (distOut)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="255" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="ขากลับถูกเบิกไหม?&#10;(ดูจาก currentTrip)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="95" y="340" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s5a" value="distRet = ระยะทางขากลับ&#10;(กลับทางเดิม = เท่าขาไป)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="455" width="230" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s5b" value="distRet = 0&#10;ขึ้นป้าย &quot;ไม่ได้เบิกขากลับ&quot;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="455" width="230" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="MetroArea.legAreas()&#10;รูปหลายเหลี่ยมจริงของ 6 จังหวัด 405 จุด&#10;บอกว่าแต่ละขาอยู่ในเขต / นอกเขต&#10;คำนวณในเครื่อง ไม่เรียกเน็ต" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="545" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="currentTrip() — นับว่าเบิกกี่เที่ยว&#10;รถส่วนตัว: ดูจากติ๊ก&#10;Taxi: ดูจากจำนวนแถวที่มีจริง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="655" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="ผู้ใช้เลือกวิธีคิดแบบไหน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="95" y="755" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s9" value="FlatRate.tripTotal(trip, cfg, {out, ret})&#10;คิดทีละเที่ยว ตามบัญชี ๘ ข้อ ๕" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="760" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s10" value="เที่ยวนี้อยู่ในเขต กทม.ปริมณฑลไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="420" y="845" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s11a" value="ในเขต → ตามช่วงระยะทาง&#10;0-10.99=150 · 11-20.99=250&#10;21-30.99=350 · 31-40.99=450&#10;41-50.99=550 · 51-60.99=650&#10;61 ขึ้นไป=750" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="955" width="240" height="95" as="geometry" />
        </mxCell>

        <mxCell id="s11b" value="นอกเขต&#10;เหมาจ่าย 1,200 บาท/เที่ยว&#10;(ระยะไม่เกิน 200 กม.)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="965" width="230" height="75" as="geometry" />
        </mxCell>

        <mxCell id="s12" value="คิดตามระยะทางจริง&#10;ค่าน้ำมัน = ระยะ x 5 บาท (บัญชี ๘ ข้อ ๔)&#10;ค่า Taxi = ตามที่กรอก (บัญชี ๘ ข้อ ๑)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="880" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s13" value="ค่า Taxi เกินเพดานไหม?&#10;ในเขต 750 · นอกเขต 1,200" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="985" width="240" height="85" as="geometry" />
        </mxCell>

        <mxCell id="s14" value="ขึ้นคำเตือนสีแดง&#10;บันทึกไม่ได้จนกว่าจะแก้" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="1105" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s15" value="รวมยอดทั้งใบ + แสดงป้าย&#10;&quot;ยอดนี้คิดจากเกณฑ์ไหน&quot;&#10;อ้างข้อของบัญชี ๘ รายขา" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="1105" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s16" value="แนบไฟล์ PDF?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="350" y="1205" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s17" value="pdf.js เรนเดอร์ทีละหน้าเป็นภาพ JPEG&#10;เกิน 10 หน้า = ถามก่อน&#10;(เอกสารวาดไฟล์แนบเป็น &lt;img&gt; เสมอ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="1200" width="280" height="80" as="geometry" />
