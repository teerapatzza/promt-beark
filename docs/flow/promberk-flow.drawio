  <diagram name="1. User กด" id="userflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="uTitle" value="พร้อมเบิก — สิ่งที่ USER กด (เวอร์ชัน 2.20.0 · 20 ต.ค. 2569)&#10;สีเขียว = ทำเสร็จแล้ว" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u1" value="เปิดหน้า &quot;ขอเบิกงบประมาณ&quot;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u2" value="เลือกหมวดงบประมาณ&#10;(TRAVEL001-004)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u3" value="กรอกชื่อผู้ขอเบิก + ชื่อกิจกรรม" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u4" value="ระบุวันออกเดินทาง / วันกลับถึง&#10;และ &quot;วันที่เบิก / วันที่สิ้นสุดกิจกรรม&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="uN4" value="ทำแล้ว 2.19.0" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1">
          <mxGeometry x="340" y="330" width="230" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u5" value="เดินทางแบบไหน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="410" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="u6a" value="ไป-กลับตามปกติ&#10;ติ๊กพาหนะครั้งเดียว มีผลทั้งสองขา" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="u6b" value="กรณีพิเศษ&#10;ติ๊กพาหนะแยกการ์ด ขาไป / ขากลับ&#10;(ขาเดียว หรือ กลับคนละทาง)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="530" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="u7" value="ติ๊กพาหนะ: รถส่วนตัว และ/หรือ Taxi&#10;(ถามเฉพาะเมื่อเบิกตามจริง)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="630" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="uN7" value="ทำแล้ว 2.19.0 — เลือกเหมาจ่าย&#10;ไม่ถามพาหนะ ซ่อนส่วน Taxi" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1">
          <mxGeometry x="340" y="630" width="250" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u8" value="พิมพ์ &quot;จุดเริ่มต้น&quot; แล้วเลือกจากรายการ&#10;(ระบบปักหมุดให้)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="710" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="u9" value="พิมพ์ &quot;จุดที่รถไปส่ง&quot; แล้วเลือกจากรายการ&#10;(ถ้าต่อเครื่องบิน = ใส่สนามบิน)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="785" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="u10" value="เลือกวิธีคิดค่าพาหนะ" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="100" y="870" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="uN10" value="ทำแล้ว 2.19.0 — ย้ายขึ้นมาถามก่อนพาหนะ" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1">
          <mxGeometry x="320" y="870" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="u11a" value="คิดตามระยะทางจริง&#10;• รถส่วนตัว = ระยะ x 5 บาท (ระบบคิดให้)&#10;• Taxi = กรอกค่าโดยสารตามมิเตอร์จริง" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="990" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="u11b" value="เหมาจ่าย&#10;ไม่ถามพาหนะ ไม่มีส่วน Taxi&#10;เคสปกติ = สองขา · กรณีพิเศษ = ติ๊กว่าเบิกขาไหน" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="990" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uN11" value="ทำแล้ว 2.19.0" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1">
          <mxGeometry x="580" y="990" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="u12" value="กรอก จาก/ถึง ของแต่ละเที่ยว Taxi&#10;ค้นหาสถานที่ได้ ปักหมุดได้ บอกระยะทางให้&#10;เงินยังกรอกตามมิเตอร์จริง" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="1090" width="270" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uN12" value="ทำแล้ว 2.20.0 — หมุดของแถว Taxi&#10;แยกจากหมุดเส้นทางหลัก ไม่กระทบเงิน" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1">
          <mxGeometry x="300" y="1090" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="u13" value="กรอกค่าใช้จ่ายอื่น&#10;ที่พัก · ตั๋วเครื่องบิน · ทางด่วน · ที่จอดรถ · อื่น ๆ" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1180" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="u14" value="แนบหลักฐาน&#10;รูปภาพ หรือ ไฟล์ PDF (หลายหน้าได้)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="1270" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="u15" value="กด &quot;ยืนยันการบันทึกรายการเบิก&quot;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1355" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u16" value="กรณีพิเศษ แต่ไม่ได้ติ๊กขากลับ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="90" y="1435" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="u17" value="ระบบถาม: &quot;เบิกเฉพาะขาไป ถูกไหม?&quot;&#10;ยกเลิก = กลับไปติ๊กขากลับ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="1440" width="250" height="60" as="geometry" />
